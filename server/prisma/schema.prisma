generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id String @id @default(uuid())
  name String
  category String
  price Float
  description String
  image String
  createdAt DateTime @default(now())
  uploadAt DateTime @updatedAt
}
